    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="x1, y1, x2, y2, x3, y3, S" type="Integer" array="False" size=""/>
            <output expression="&quot;A &#1094;&#1101;&#1075;&#1080;&#1081;&#1085; &#1082;&#1086;&#1086;&#1088;&#1076;&#1080;&#1085;&#1072;&#1090; (x1): &quot;" newline="True"/>
            <input variable="x1"/>
            <output expression="&quot;A &#1094;&#1101;&#1075;&#1080;&#1081;&#1085; &#1082;&#1086;&#1086;&#1088;&#1076;&#1080;&#1085;&#1072;&#1090; (y): &quot;" newline="True"/>
            <input variable="y1"/>
            <output expression="&quot;B &#1094;&#1101;&#1075;&#1080;&#1081;&#1085; &#1082;&#1086;&#1086;&#1088;&#1076;&#1080;&#1085;&#1072;&#1090; (x2): &quot;" newline="True"/>
            <input variable="x2"/>
            <output expression="&quot;B &#1094;&#1101;&#1075;&#1080;&#1081;&#1085; &#1082;&#1086;&#1086;&#1088;&#1076;&#1080;&#1085;&#1072;&#1090; (y2): &quot;" newline="True"/>
            <input variable="y2"/>
            <output expression="&quot;C &#1094;&#1101;&#1075;&#1080;&#1081;&#1085; &#1082;&#1086;&#1086;&#1088;&#1076;&#1080;&#1085;&#1072;&#1090; (x3): &quot;" newline="True"/>
            <input variable="x3"/>
            <output expression="&quot;C &#1094;&#1101;&#1075;&#1080;&#1081;&#1085; &#1082;&#1086;&#1086;&#1088;&#1076;&#1080;&#1085;&#1072;&#1090; (y3): &quot;" newline="True"/>
            <input variable="y3"/>
            <assign variable="S" expression="0.5*abs(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2))"/>
            <output expression="&quot;&#1043;&#1091;&#1088;&#1074;&#1072;&#1083;&#1078;&#1085;&#1099; &#1090;&#1072;&#1083;&#1073;&#1072;&#1081;: &quot;&amp;S" newline="True"/>
        </body>
    </function>
</flowgorithm>
