<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week_2_D3"/>
        <attribute name="authors" value="kay"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-15 05:24:50 PM"/>
        <attribute name="created" value="a2F5O0VOVlk7MjAyNi0wOS0xNTswNToyMToxNiBQTTsxOTMx"/>
        <attribute name="edited" value="a2F5O0VOVlk7MjAyNi0wOS0xNTswNToyNDo1MCBQTTsxOzIwNDA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, p, S" type="Real" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <if expression="(a + b &gt; c) and (a + c &gt; b) and (b + c &gt; a)">
                <then>
                    <assign variable="p" expression="(a + b + c) / 2"/>
                    <assign variable="S" expression="sqrt(p * (p - a) * (p - b) * (p - c))"/>
                    <output expression="&quot;&#1058;&#1072;&#1083;&#1073;&#1072;&#1081;: &quot; &amp; S" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;&#1048;&#1081;&#1084; &#1075;&#1091;&#1088;&#1074;&#1072;&#1083;&#1078;&#1080;&#1085; &#1086;&#1088;&#1096;&#1080;&#1085; &#1090;&#1086;&#1075;&#1090;&#1085;&#1086;&#1093;&#1075;&#1199;&#1081;&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
