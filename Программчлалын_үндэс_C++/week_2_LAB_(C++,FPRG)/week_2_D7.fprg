<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week_2_D7"/>
        <attribute name="authors" value="kay"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 01:13:12 PM"/>
        <attribute name="created" value="a2F5O0VOVlk7MjAyNi0wOS0xNjswMToxMDozNyBQTTsxOTI5"/>
        <attribute name="edited" value="a2F5O0VOVlk7MjAyNi0wOS0xNjswMToxMzoxMiBQTTsxOzIwMzM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N, P, i" type="Integer" array="False" size=""/>
            <input variable="N"/>
            <assign variable="P" expression="1"/>
            <assign variable="i" expression="1"/>
            <while expression="i&lt;=N">
                <assign variable="P" expression="P*i"/>
                <assign variable="i" expression="i+2"/>
                <output expression="&quot;&#1198;&#1088;&#1078;&#1074;&#1101;&#1088;: &quot; &amp; P" newline="True"/>
            </while>
        </body>
    </function>
</flowgorithm>
