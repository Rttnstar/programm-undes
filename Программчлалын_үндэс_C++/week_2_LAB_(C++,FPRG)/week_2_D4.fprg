<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="week_2_D4"/>
        <attribute name="authors" value="kay"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 01:03:58 PM"/>
        <attribute name="created" value="a2F5O0VOVlk7MjAyNi0wOS0xNjsxMjo1ODoyMSBQTTsxOTM2"/>
        <attribute name="edited" value="a2F5O0VOVlk7MjAyNi0wOS0xNjswMTowMzo1OCBQTTsxOzIwNDI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, D, x1, x2" type="Real" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <assign variable="D" expression="b^2 - 4*a*c"/>
            <if expression="D&gt;0">
                <then>
                    <assign variable="x1" expression="(-b + sqrt(D)) / (2*a)"/>
                    <assign variable="x2" expression="(-b - sqrt(D)) / (2*a)"/>
                    <output expression="&quot;x1 = &quot; &amp; x1 &amp; &quot;, x2 = &quot; &amp; x2" newline="True"/>
                </then>
                <else>
                    <if expression="D==0">
                        <then>
                            <assign variable="x1" expression="-b / (2*a)"/>
                            <output expression="&quot;x = &quot; &amp; x1" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;&#1041;&#1086;&#1076;&#1080;&#1090; &#1096;&#1080;&#1081;&#1076;&#1075;&#1199;&#1081;&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
